# 复制为 .env 后按需修改；不配置则全部用下面的默认值。

# ---- 服务器域名部署（--profile proxy）才需要 ----
# 反向代理对外域名，Caddy 会据此自动签发 HTTPS 证书
DOMAIN=your-domain.com

# ---- 宿主机发布端口（默认即规范端口，端口被占用时可改）----
# 注意：前端在 localhost 访问时会直连 :10090(IM_WS) 和 :10093(STREAMING)，
# 单机标准部署请保持这两个为默认值，否则前端 WebSocket 连不上。
WEB_PORT=2470
USER_API_PORT=8887
SOCIAL_API_PORT=8889
IM_API_PORT=8890
TREND_API_PORT=8891
IM_WS_PORT=10090
STREAMING_PORT=10093
