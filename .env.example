# 复制为 .env 后按需修改。hichat2.sh 和 Docker Compose 都会读取该文件。

# ---- 服务器域名部署（--profile proxy）才需要 ----
# 反向代理对外域名，Caddy 会据此自动签发 HTTPS 证书
DOMAIN=your-domain.com

# ---- 宿主机发布端口（默认即规范端口，端口被占用时可改）----
# 注意：前端在 localhost 访问时会直连 :10090(IM_WS) 和 :10093(STREAMING)，
# 单机标准部署请保持这两个为默认值，否则前端 WebSocket 连不上。
WEB_PORT=2470
USER_API_PORT=8887
SOCIAL_API_PORT=8889
IM_API_PORT=8890
TREND_API_PORT=8891
IM_WS_PORT=10090
STREAMING_PORT=10093

# 可选：覆盖 sample YAML 中 IM RPC、IM API 和 Task MQ 共享的本地开发密钥。
# 生产环境必须设置为独立于 JWT/TURN 的随机值：openssl rand -hex 32
HICHAT_IM_RPC_AUTH_SECRET=

# ---- 公网群通话 SFU / TURN ----
# 公网部署必须改成服务器公网 IP；本地只启动 streaming 时可留空。
PUBLIC_IP=
# SFU 自身媒体端口，不要与 coturn relay 端口范围重叠。
SFU_UDP_MIN_PORT=50000
SFU_UDP_MAX_PORT=50200
# 生产必须生成随机长密钥；coturn 与 streaming 会共用该变量。
TURN_SECRET=
TURN_PORT=3478
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
# 将 203.0.113.10 替换为 PUBLIC_IP；同时提供 UDP 和 TCP fallback。
TURN_URLS=turn:203.0.113.10:3478?transport=udp,turn:203.0.113.10:3478?transport=tcp
TURN_TTL_SECONDS=3600
