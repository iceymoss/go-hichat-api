syntax = "v1"

info (
	title:  "社交服务api模块"
	author: "iceymoss"
)

type (
	Friends {
		Id           string `json:"id,omitempty"` // 用户ID（好友的用户ID，不是关系表ID）
		FriendUid    string `json:"friend_uid,omitempty"` // 好友用户ID（与id相同，保留用于兼容）
		Nickname     string `json:"nickname,omitempty"` // 昵称
		Avatar       string `json:"avatar,omitempty"` // 头像
		Remark       string `json:"remark,omitempty"` // 备注
		Sex          int32  `json:"sex,omitempty"` // 性别（0-未知 1-男 2-女）
		Email        string `json:"email,omitempty"` // 邮箱
		Phone        string `json:"phone,omitempty"` // 手机号
		Introduction string `json:"introduction,omitempty"` // 个性签名
		Region       string `json:"region,omitempty"` // 地区
		Occupation   string `json:"occupation,omitempty"` // 职业
		Tags         string `json:"tags,omitempty"` // 个人标签（JSON数组字符串）
		Status       int32  `json:"status,omitempty"` // 用户状态（0-禁用 1-正常）
		Type         int32  `json:"type,omitempty"` // 用户类型（0-普通用户 1-管理员）
		LastLogin    int64  `json:"last_login,omitempty"` // 最后登录时间（时间戳）
	}
	FriendRequests {
		Id            int64  `json:"id,omitempty"`
		UserId        string `json:"user_id,omitempty"`
		ReqUid        string `json:"req_uid,omitempty"`
		ReqMsg        string `json:"req_msg,omitempty"`
		MessageStatus int    `json:"message_status,omitempty"` // 消息状态（0:已删除 1:正常显示 2:忽略不显示）
		ReqTime       int64  `json:"req_time,omitempty"`
		HandleResult  int    `json:"handle_result"` // 0-待处理, 1-已同意, 2-已拒绝, 3-已忽略（不使用omitempty确保0值也会返回）
		Status        string `json:"status,omitempty"` // 状态文本: pending-待处理, accepted-已同意, rejected-已拒绝, ignored-已忽略
		StatusText    string `json:"status_text,omitempty"` // 状态中文文本: 待处理, 已同意, 已拒绝, 已忽略
		HandleMsg     string `json:"handle_msg,omitempty"`
	}
	Groups {
		Id              string `json:"id,omitempty"`
		Name            string `json:"name,omitempty"`
		Icon            string `json:"icon,omitempty"`
		Status          int64  `json:"status,omitempty"`
		GroupType       int64  `json:"group_type,omitempty"`
		IsVerify        bool   `json:"is_verify,omitempty"`
		Notification    string `json:"notification,omitempty"`
		NotificationUid string `json:"notification_uid,omitempty"`
		CreateUid       string `json:"create_uid,omitempty"`
	}
	User {
		Id            string `json:"id,omitempty"`
		Nickname      string `json:"nickname,omitempty"`
		Sex           int    `json:"sex,omitempty"`
		Avatar        string `json:"avatar,omitempty"`
		Introduction  string `json:"introduction,omitempty"`
		IsCurrentUser int    `json:"is_current_user,omitempty"`
	}
	GroupMembers {
		Id            int64  `json:"id,omitempty"`
		GroupId       string `json:"group_id,omitempty"`
		UserId        string `json:"user_id,omitempty"`
		Nickname      string `json:"nickname,omitempty"`
		UserAvatarUrl string `json:"user_avatar_url,omitempty"`
		RoleLevel     int    `json:"role_level,omitempty"`
		InviterUid    string `json:"inviter_uid,omitempty"`
		OperatorUid   string `json:"operator_uid,omitempty"`
		User          User   `json:"user,omitempty"`
	}
	GroupRequests {
		Id            int64  `json:"id,omitempty"`
		UserId        string `json:"user_id,omitempty"`
		GroupId       string `json:"group_id,omitempty"`
		ReqMsg        string `json:"req_msg,omitempty"`
		ReqTime       int64  `json:"req_time,omitempty"`
		JoinSource    int64  `json:"join_source,omitempty"`
		InviterUserId string `json:"inviter_user_id,omitempty"`
		HandleUserId  string `json:"handle_user_id,omitempty"`
		HandleTime    int64  `json:"handle_time,omitempty"`
		HandleResult  int64  `json:"handle_result,omitempty"`
		User          User   `json:"user,omitempty"`
		Group         Groups `json:"group,omitempty"`
	}
)

type (
	FriendPutInReq {
		ReqMsg  string `json:"req_msg,omitempty"`
		ReqTime int64  `json:"req_time,omitempty"`
		UserId  string `json:"user_uid"`
	}
	FriendPutInResp  {}
)

// 好友管理：备注/删除/拉黑/朋友圈权限/分享/通知/置顶/静音/标签/举报
type (
	FriendRemarkReq {
		FriendUid string `json:"friend_uid"`
		Remark    string `json:"remark"`
	}
	FriendRemarkResp  {}
	FriendDeleteReq {
		FriendUid string `json:"friend_uid"`
	}
	FriendDeleteResp  {}
	FriendBlockReq {
		FriendUid string `json:"friend_uid"`
		Block     bool   `json:"block"`
	}
	FriendBlockResp  {}
	FriendMomentsPermissionReq {
		FriendUid  string `json:"friend_uid"`
		Permission int32  `json:"permission"` // 0允许 1仅聊天 2屏蔽朋友圈
	}
	FriendMomentsPermissionResp  {}
	FriendShareReq {
		FriendUid string `json:"friend_uid"`
		TargetUid string `json:"target_uid,optional"`
	}
	FriendShareResp  {}
	FriendNotificationReq {
		FriendUid string `json:"friend_uid"`
		Enabled   bool   `json:"enabled"`
	}
	FriendNotificationResp  {}
	FriendPinReq {
		FriendUid string `json:"friend_uid"`
		Pinned    bool   `json:"pinned"`
	}
	FriendPinResp  {}
	FriendMuteReq {
		FriendUid string `json:"friend_uid"`
		Muted     bool   `json:"muted"`
	}
	FriendMuteResp  {}
	FriendTagsReq {
		FriendUid string   `json:"friend_uid"`
		Tags      []string `json:"tags"`
	}
	FriendTagsResp  {}
	FriendReportReq {
		FriendUid string `json:"friend_uid"`
		Reason    string `json:"reason,optional"`
	}
	FriendReportResp  {}
)

type (
	FriendPutInHandleReq {
		FriendReqId  int32 `json:"friend_req_id,omitempty"`
		HandleResult int32 `json:"handle_result,omitempty"` // 处理结果
	}
	FriendPutInHandleResp  {}
)

type (
	FriendPutInListReq {
		Type  int32  `form:"type,optional"` // 处理类型：0-待处理, 1-已通过, 2-已拒绝, 3-已忽略
		Class string `form:"class,optional"` // 申请列表类型：0-我发起的申请, 1-我收到的申请
	}
	FriendPutInListResp {
		List []*FriendRequests `json:"list"`
	}
	FriendPutInDeleteReq {
		FriendReqId int32 `json:"friend_req_id,omitempty"` // 申请ID
	}
	FriendPutInDeleteResp  {}
	FriendPutInMessageCountReq  {}
	FriendPutInMessageCountResp {
		Count int32 `json:"count,omitempty"` // 消息数量
	}
)

type (
	FriendListReq  {}
	FriendListResp {
		List []*Friends `json:"list"`
	}
)

type (
	GroupCreateReq {
		Name string `json:"name,omitempty"`
		Icon string `json:"icon,omitempty"`
	}
	GroupCreateResp  {}
)

type (
	GroupPutInRep {
		GroupId    string `json:"group_id,omitempty"`
		ReqMsg     string `json:"req_msg,omitempty"`
		ReqTime    int64  `json:"req_time,omitempty"`
		JoinSource int64  `json:"join_source,omitempty"`
		InviterUid string `json:"inviter_uid,omitempty"`
	}
	GroupPutInResp {
		GroupId int `json:"group_id,omitempty"`
	}
)

type (
	GroupPutInHandleRep {
		GroupReqId   int32  `json:"group_req_id,omitempty"`
		GroupId      string `json:"group_id,omitempty"`
		HandleResult int32  `json:"handle_result,omitempty"` // 处理结果
	}
	GroupPutInHandleResp  {}
)

type (
	GroupPutInListRep {
		GroupId string  `json:"group_id,omitempty"`
		Type    []int32 `json:"type,optional"`
		Class   int32   `json:"class,optional"`
	}
	GroupPutInListResp {
		List []*GroupRequests `json:"list,omitempty"`
	}
)

type (
	GroupListRep  {}
	GroupListResp {
		List []*Groups `json:"list,omitempty"`
	}
)

type (
	GroupUserListReq {
		GroupId string `json:"group_id,omitempty"`
	}
	GroupUserListResp {
		List []*GroupMembers `json:"List,omitempty"`
	}
)

type (
	FriendsOnlineReq  {}
	FriendsOnlineResp {
		OnlineList map[string]bool `json:"onLineList"`
	}
)

type (
	GroupUserOnlineReq {
		GroupId string `json:"group_id,omitempty"`
	}
	GroupUserOnlineResp {
		OnlineList map[string]bool `json:"onLineList"`
	}
)

@server (
	prefix: v1/social
	group:  friend
	jwt:    JwtAuth
)
service social {
	@doc "好友申请"
	@handler friendPutIn
	post /friend/putIn (FriendPutInReq) returns (FriendPutInResp)

	@doc "更新好友备注"
	@handler friendRemark
	post /friend/remark (FriendRemarkReq) returns (FriendRemarkResp)

	@doc "删除好友（双向）"
	@handler friendDelete
	post /friend/delete (FriendDeleteReq) returns (FriendDeleteResp)

	@doc "拉黑/取消拉黑"
	@handler friendBlock
	post /friend/block (FriendBlockReq) returns (FriendBlockResp)

	@doc "朋友圈权限"
	@handler friendMomentsPermission
	post /friend/momentsPermission (FriendMomentsPermissionReq) returns (FriendMomentsPermissionResp)

	@doc "消息通知开关"
	@handler friendNotification
	post /friend/notification (FriendNotificationReq) returns (FriendNotificationResp)

	@doc "置顶开关"
	@handler friendPin
	post /friend/pin (FriendPinReq) returns (FriendPinResp)

	@doc "静音开关"
	@handler friendMute
	post /friend/mute (FriendMuteReq) returns (FriendMuteResp)

	@doc "好友标签设置"
	@handler friendTags
	post /friend/tags (FriendTagsReq) returns (FriendTagsResp)

	@doc "好友举报"
	@handler friendReport
	post /friend/report (FriendReportReq) returns (FriendReportResp)

	@doc "好友分享（预留）"
	@handler friendShare
	post /friend/share (FriendShareReq) returns (FriendShareResp)

	@doc "好友申请处理"
	@handler friendPutInHandle
	put /friend/putIn (FriendPutInHandleReq) returns (FriendPutInHandleResp)

	@doc "好友申请列表"
	@handler friendPutInList
	get /friend/putIns (FriendPutInListReq) returns (FriendPutInListResp)

	@doc "删除好友申请"
	@handler friendPutInDelete
	post /friend/putIn/delete (FriendPutInDeleteReq) returns (FriendPutInDeleteResp)

	@doc "获取好友申请消息数量"
	@handler friendPutInMessageCount
	get /friend/putIn/messageCount (FriendPutInMessageCountReq) returns (FriendPutInMessageCountResp)

	@doc "好友列表"
	@handler friendList
	get /friends (FriendListReq) returns (FriendListResp)

	@doc "好友在线情况"
	@handler friendsOnline
	get /friends/online (FriendsOnlineReq) returns (FriendsOnlineResp)
}

@server (
	prefix: v1/social
	group:  group
	jwt:    JwtAuth
)
service social {
	@doc "创群"
	@handler createGroup
	post /group (GroupCreateReq) returns (GroupCreateResp)

	@doc "申请进群"
	@handler groupPutIn
	post /group/putIn (GroupPutInRep) returns (GroupPutInResp)

	@doc "申请进群处理"
	@handler groupPutInHandle
	put /group/putIn (GroupPutInHandleRep) returns (GroupPutInHandleResp)

	@doc "申请进群列表"
	@handler groupPutInList
	get /group/putIns (GroupPutInListRep) returns (GroupPutInListResp)

	@doc "用户申群列表"
	@handler groupList
	get /groups (GroupListRep) returns (GroupListResp)

	@doc "成员列表列表"
	@handler groupUserList
	get /group/users (GroupUserListReq) returns (GroupUserListResp)

	@doc "群在线用户"
	@handler groupUserOnline
	get /group/users/online (GroupUserOnlineReq) returns (GroupUserOnlineResp)
}

