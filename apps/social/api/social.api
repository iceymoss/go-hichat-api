syntax = "v1"

info (
	title:  "社交服务api模块"
	author: "iceymoss"
)

type (
	Friends {
		Id                string   `json:"id,omitempty"` // 用户ID（好友的用户ID，不是关系表ID）
		FriendUid         string   `json:"friend_uid,omitempty"` // 好友用户ID（与id相同，保留用于兼容）
		Nickname          string   `json:"nickname,omitempty"` // 昵称
		Avatar            string   `json:"avatar,omitempty"` // 头像
		Remark            string   `json:"remark,omitempty"` // 备注
		Sex               int32    `json:"sex,omitempty"` // 性别（0-未知 1-男 2-女）
		Email             string   `json:"email,omitempty"` // 邮箱
		Phone             string   `json:"phone,omitempty"` // 手机号
		Introduction      string   `json:"introduction,omitempty"` // 个性签名
		Region            string   `json:"region,omitempty"` // 地区
		Occupation        string   `json:"occupation,omitempty"` // 职业
		Tags              string   `json:"tags,omitempty"` // 个人标签（JSON数组字符串）
		Status            int32    `json:"status,omitempty"` // 用户状态（0-禁用 1-正常）
		Type              int32    `json:"type,omitempty"` // 用户类型（0-普通用户 1-管理员）
		LastLogin         int64    `json:"last_login,omitempty"` // 最后登录时间（时间戳）
		Blacklisted       bool     `json:"blacklisted,omitempty"` // 是否拉黑
		MomentsPermission int32    `json:"moments_permission,omitempty"` // 朋友圈权限 0允许 1仅聊天 2屏蔽朋友圈
		NotifyEnabled     bool     `json:"notify_enabled,omitempty"` // 消息通知开关
		Pinned            bool     `json:"pinned,omitempty"` // 是否置顶
		Muted             bool     `json:"muted,omitempty"` // 是否静音
		FriendTags        []string `json:"friend_tags,omitempty"` // 好友标签数组
	}
	FriendRequests {
		Id            int64  `json:"id,omitempty"`
		UserId        string `json:"user_id,omitempty"`
		ReqUid        string `json:"req_uid,omitempty"`
		ReqMsg        string `json:"req_msg,omitempty"`
		MessageStatus int    `json:"message_status,omitempty"` // 消息状态（0:已删除 1:正常显示 2:忽略不显示）
		ReqTime       int64  `json:"req_time,omitempty"`
		HandleResult  int    `json:"handle_result"` // 0-待处理, 1-已同意, 2-已拒绝, 3-已忽略（不使用omitempty确保0值也会返回）
		Status        string `json:"status,omitempty"` // 状态文本: pending-待处理, accepted-已同意, rejected-已拒绝, ignored-已忽略
		StatusText    string `json:"status_text,omitempty"` // 状态中文文本: 待处理, 已同意, 已拒绝, 已忽略
		HandleMsg     string `json:"handle_msg,omitempty"`
		ReadState     int    `json:"read_state,omitempty"` // 读取状态 0未读 1已读
		RequestId     string `json:"request_id"`
		PeerUid       string `json:"peer_uid"`
		HandledAt     int64  `json:"handled_at,omitempty"`
		Actionable    bool   `json:"actionable"`
		// 用户信息字段
		Nickname     string `json:"nickname,omitempty"` // 昵称
		Avatar       string `json:"avatar,omitempty"` // 头像
		Sex          int32  `json:"sex,omitempty"` // 性别（0-未知 1-男 2-女）
		Email        string `json:"email,omitempty"` // 邮箱
		Phone        string `json:"phone,omitempty"` // 手机号
		Introduction string `json:"introduction,omitempty"` // 个性签名
		Region       string `json:"region,omitempty"` // 地区
		Occupation   string `json:"occupation,omitempty"` // 职业
		Tags         string `json:"tags,omitempty"` // 个人标签（JSON数组字符串）
		UserStatus   int32  `json:"user_status,omitempty"` // 用户状态（0-禁用 1-正常）
		UserType     int32  `json:"user_type,omitempty"` // 用户类型（0-普通用户 1-管理员）
		LastLogin    int64  `json:"last_login,omitempty"` // 最后登录时间（时间戳）
	}
	Groups {
		Id              string `json:"id,omitempty"`
		Name            string `json:"name,omitempty"`
		Icon            string `json:"icon,omitempty"`
		Description     string `json:"description,omitempty"` // 群描述
		Status          int64  `json:"status,omitempty"`
		GroupType       int64  `json:"group_type,omitempty"`
		IsVerify        bool   `json:"is_verify,omitempty"`
		Notification    string `json:"notification,omitempty"`
		NotificationUid string `json:"notification_uid,omitempty"`
		CreateUid       string `json:"create_uid,omitempty"`
		GroupNickname   string `json:"group_nickname,omitempty"`
		GroupRemark     string `json:"group_remark,omitempty"`
	}
	User {
		Id            string `json:"id,omitempty"`
		Nickname      string `json:"nickname,omitempty"`
		Sex           int    `json:"sex,omitempty"`
		Avatar        string `json:"avatar,omitempty"`
		Introduction  string `json:"introduction,omitempty"`
		IsCurrentUser int    `json:"is_current_user,omitempty"`
	}
	GroupMembers {
		Id            int64  `json:"id,omitempty"`
		GroupId       string `json:"group_id,omitempty"`
		UserId        string `json:"user_id,omitempty"`
		Nickname      string `json:"nickname,omitempty"`
		UserAvatarUrl string `json:"user_avatar_url,omitempty"`
		RoleLevel     int    `json:"role_level"`
		InviterUid    string `json:"inviter_uid,omitempty"`
		OperatorUid   string `json:"operator_uid,omitempty"`
		GroupNickname string `json:"group_nickname,omitempty"`
		GroupRemark   string `json:"group_remark,omitempty"`
		User          User   `json:"user,omitempty"`
	}
	GroupRequests {
		Id                 int64  `json:"id,omitempty"`
		UserId             string `json:"user_id,omitempty"`
		GroupId            string `json:"group_id,omitempty"`
		ReqMsg             string `json:"req_msg,omitempty"`
		ReqTime            int64  `json:"req_time,omitempty"`
		JoinSource         int64  `json:"join_source,omitempty"`
		InviterUserId      string `json:"inviter_user_id,omitempty"`
		HandleUserId       string `json:"handle_user_id,omitempty"`
		HandleTime         int64  `json:"handle_time,omitempty"`
		HandleResult       int64  `json:"handle_result,omitempty"`
		ReceiverRead       int64  `json:"receiver_read,omitempty"`
		RequestId          string `json:"request_id"`
		ApplicantUid       string `json:"applicant_uid"`
		HandleMsg          string `json:"handle_msg,omitempty"`
		InvalidReason      string `json:"invalid_reason,omitempty"`
		ActualJoinSource   int32  `json:"actual_join_source,omitempty"`
		SourceType         int32  `json:"source_type"`
		SourceInvitationId string `json:"source_invitation_id,omitempty"`
		ReadState          int32  `json:"read_state"`
		Actionable         bool   `json:"actionable"`
		User               User   `json:"user,omitempty"`
		Group              Groups `json:"group,omitempty"`
	}
	GroupPutInsReadReq {
		RequestIds []string `json:"request_ids"`
	}
	GroupPutInsReadResp {
		Count  int32 `json:"count"`
		Apply  int32 `json:"apply"`
		Result int32 `json:"result"`
		Invite int32 `json:"invite"`
	}
)

type (
	FriendPutInReq {
		ReqMsg string `json:"req_msg,omitempty"`
		UserId string `json:"user_uid"`
		Remark string `json:"remark,optional"` // 申请人为对方预设的备注
	}
	FriendPutInResp {
		RequestId      int64 `json:"request_id"`
		Status         int32 `json:"status"`
		AlreadyPending bool  `json:"already_pending"`
		AlreadyFriend  bool  `json:"already_friend"`
	}
)

// 好友管理：备注/删除/拉黑/朋友圈权限/分享/通知/置顶/静音/标签/举报
type (
	FriendRemarkReq {
		FriendUid string `json:"friend_uid"`
		Remark    string `json:"remark"`
	}
	FriendRemarkResp  {}
	FriendDeleteReq {
		FriendUid string `json:"friend_uid"`
	}
	FriendDeleteResp  {}
	FriendBlockReq {
		FriendUid string `json:"friend_uid"`
		Block     bool   `json:"block"`
	}
	FriendBlockResp  {}
	FriendMomentsPermissionReq {
		FriendUid  string `json:"friend_uid"`
		Permission int32  `json:"permission"` // 0允许 1仅聊天 2屏蔽朋友圈
	}
	FriendMomentsPermissionResp  {}
	FriendShareReq {
		FriendUid string `json:"friend_uid"`
		TargetUid string `json:"target_uid,optional"`
	}
	FriendShareResp  {}
	FriendNotificationReq {
		FriendUid string `json:"friend_uid"`
		Enabled   bool   `json:"enabled"`
	}
	FriendNotificationResp  {}
	FriendPinReq {
		FriendUid string `json:"friend_uid"`
		Pinned    bool   `json:"pinned"`
	}
	FriendPinResp  {}
	FriendMuteReq {
		FriendUid string `json:"friend_uid"`
		Muted     bool   `json:"muted"`
	}
	FriendMuteResp  {}
	FriendTagsReq {
		FriendUid string   `json:"friend_uid"`
		Tags      []string `json:"tags"`
	}
	FriendTagsResp  {}
	FriendReportReq {
		FriendUid string `json:"friend_uid"`
		Reason    string `json:"reason,optional"`
	}
	FriendReportResp  {}
)

type (
	FriendPutInHandleReq {
		FriendReqId  int32    `json:"friend_req_id,omitempty"`
		RequestId    string   `json:"request_id,optional"`
		HandleResult int32    `json:"handle_result,omitempty"` // 处理结果
		HandleMsg    string   `json:"handle_msg,optional"` // 处理附言/回复
		Remark       string   `json:"remark,omitempty"` // 备注
		Tags         []string `json:"tags,omitempty"` // 标签
	}
	FriendPutInHandleResp {
		RequestId    string `json:"request_id"`
		HandleResult int32  `json:"handle_result"`
		Idempotent   bool   `json:"idempotent"`
	}
)

type (
	FriendPutInReadReq {
		FriendReqId int32    `json:"friend_req_id,omitempty"` // 0 或不传表示全部已读
		RequestIds  []string `json:"request_ids,optional"`
	}
	FriendPutInReadResp {
		Count  int32 `json:"count"`
		Apply  int32 `json:"apply"`
		Result int32 `json:"result"`
	}
)

type (
	FriendPutInListReq {
		Type   int32  `form:"type,optional"` // 处理类型：0-待处理, 1-已通过, 2-已拒绝, 3-已忽略
		Class  string `form:"class,optional"` // 申请列表类型：0-我发起的申请, 1-我收到的申请
		Status *int32 `form:"status,optional"`
		Page   int32  `form:"page,optional"`
		Size   int32  `form:"size,optional"`
	}
	FriendPutInListResp {
		List  []*FriendRequests `json:"list"`
		Total int64             `json:"total"`
	}
	FriendPutInDeleteReq {
		FriendReqId int32  `json:"friend_req_id,omitempty"` // 申请ID
		RequestId   string `json:"request_id,optional"`
	}
	FriendPutInDeleteResp  {}
	FriendPutInMessageCountReq  {}
	FriendPutInMessageCountResp {
		Count  int32 `json:"count"` // 未读消息数量（确保 0 也返回）
		Apply  int32 `json:"apply"`
		Result int32 `json:"result"`
	}
)

type (
	FriendListReq  {}
	FriendListResp {
		List []*Friends `json:"list"`
	}
)

type (
	GroupCreateReq {
		Name        string `json:"name,omitempty"`
		Icon        string `json:"icon,omitempty"`
		Description string `json:"description,optional"`
	}
	GroupCreateResp {
		GroupId string `json:"group_id"`
	}
)

type (
	GroupPutInReq {
		GroupId string `json:"group_id"`
		ReqMsg  string `json:"req_msg,optional"` // 申请消息
	}
	GroupPutInResp {
		GroupId        string `json:"group_id"`
		IsPass         int    `json:"is_pass"` // 1=直接进群, 0=进入申请流程
		RequestId      string `json:"request_id,omitempty"`
		Status         int32  `json:"status"`
		AlreadyPending bool   `json:"already_pending,omitempty"`
		AlreadyMember  bool   `json:"already_member,omitempty"`
	}
)

type (
	GroupPutInHandleReq {
		RequestId    string `json:"request_id"`
		HandleResult int32  `json:"handle_result,omitempty"` // 处理结果
		HandleMsg    string `json:"handle_msg,optional"`
	}
	GroupPutInHandleResp {
		RequestId    string `json:"request_id"`
		HandleResult int32  `json:"handle_result"`
		Idempotent   bool   `json:"idempotent,omitempty"`
	}
)

type (
	GroupPutInListReq {
		GroupId string  `form:"group_id,optional"`
		Type    []int32 `form:"type,optional"`
		Class   int32   `form:"class,optional"`
	}
	GroupPutInListResp {
		List  []*GroupRequests `json:"list,omitempty"`
		Total int64            `json:"total"`
	}
)

type (
	GetGroupPutListByUidReq {
		Class  string `form:"class,optional"` // 类别：1-我发起的申请，2-我接受到的申请
		Type   string `form:"type,optional"` // 状态：0-未处理，1-已通过，2-已拒绝，3-已忽略
		Status *int32 `form:"status,optional"`
		Page   int32  `form:"page,optional"`
		Size   int32  `form:"size,optional"`
	}
	GetGroupPutListByUidResp {
		List  []*GroupRequests `json:"list,omitempty"`
		Total int64            `json:"total"`
	}
)

type (
	GroupListReq  {}
	GroupListResp {
		List []*Groups `json:"list,omitempty"`
	}
)

type (
	GroupUserListReq {
		GroupId string `form:"group_id,optional"`
	}
	GroupUserListResp {
		List []*GroupMembers `json:"List,omitempty"`
	}
)

type (
	GroupQuitReq {
		GroupId string `json:"group_id"`
	}
	GroupQuitResp  {}
)

type (
	GroupKickReq {
		GroupId   string   `json:"group_id"`
		MemberIds []string `json:"member_ids"`
	}
	GroupKickResp  {}
)

type (
	GroupInviteReq {
		GroupId   string   `json:"group_id"`
		FriendIds []string `json:"friend_ids"`
	}
	GroupInviteResp  {}
)

type (
	GroupInvitation {
		Id                  string `json:"id"`
		GroupId             string `json:"group_id"`
		InviterUid          string `json:"inviter_uid"`
		InviteeUid          string `json:"invitee_uid"`
		InviterRoleSnapshot int32  `json:"inviter_role_snapshot"`
		Message             string `json:"message,omitempty"`
		Status              int32  `json:"status"` // 0=pending, 1=accepted, 2=rejected, 3=invalidated, 4=expired
		RejectReason        string `json:"reject_reason,omitempty"`
		CreatedAt           int64  `json:"created_at"`
		HandledAt           int64  `json:"handled_at,omitempty"`
		ExpiresAt           int64  `json:"expires_at"`
		ReadState           int32  `json:"read_state"`
		Actionable          bool   `json:"actionable"`
	}
	GroupInvitationCreateReq {
		GroupId    string `json:"group_id"`
		InviteeUid string `json:"invitee_uid"`
		Message    string `json:"message,optional"`
	}
	GroupInvitationCreateResp {
		Invitation GroupInvitation `json:"invitation"`
	}
	GroupInvitationListReq {
		Status *int32 `form:"status,optional"`
		Page   int32  `form:"page,optional"`
		Size   int32  `form:"size,optional"`
	}
	GroupInvitationListResp {
		List  []GroupInvitation `json:"list"`
		Total int64             `json:"total"`
	}
	GroupInvitationHandleReq {
		Id        string `path:"id"`
		Result    int32  `json:"result"`
		HandleMsg string `json:"handle_msg,optional"`
	}
	GroupInvitationHandleResp {
		InvitationId   string `json:"invitation_id"`
		Status         int32  `json:"status"`
		JoinState      string `json:"join_state"`
		GroupRequestId string `json:"group_request_id,omitempty"`
		Idempotent     bool   `json:"idempotent,omitempty"`
		GroupId        string `json:"group_id"`
	}
	GroupInvitationReadReq {
		InvitationIds []string `json:"invitation_ids"`
	}
	GroupInvitationReadResp {
		Count  int32 `json:"count"`
		Apply  int32 `json:"apply"`
		Result int32 `json:"result"`
		Invite int32 `json:"invite"`
	}
	GroupRequestMessageCountReq  {}
	GroupRequestMessageCountResp {
		Count  int32 `json:"count"`
		Apply  int32 `json:"apply"`
		Result int32 `json:"result"`
		Invite int32 `json:"invite"`
	}
)

type (
	GroupUpdateReq {
		GroupId      string `json:"group_id"`
		Name         string `json:"name,optional"`
		Icon         string `json:"icon,optional"`
		Description  string `json:"description,optional"`
		Notification string `json:"notification,optional"`
		IsVerify     int32  `json:"is_verify,optional"` // -1不修改 0不需要验证 1需要验证
	}
	GroupUpdateResp  {}
)

type (
	GroupDisbandReq {
		GroupId string `json:"group_id"`
	}
	GroupDisbandResp  {}
)

type (
	GroupTransferOwnerReq {
		GroupId             string `json:"group_id"`
		NewOwnerId          string `json:"new_owner_id"`
		KeepOldOwnerAsAdmin bool   `json:"keep_old_owner_as_admin,optional"` // 默认 true（服务端兜底）
	}
	GroupTransferOwnerResp  {}
)

type (
	GroupSetAdminReq {
		GroupId   string   `json:"group_id"`
		MemberIds []string `json:"member_ids"`
		IsAdmin   bool     `json:"is_admin"` // true=设为管理员 false=取消管理员
	}
	GroupSetAdminResp  {}
)

// ---------------- 邀请链接/二维码入群 ----------------
type (
	GroupInviteLink {
		Token     string `json:"token,omitempty"`
		GroupId   string `json:"group_id,omitempty"`
		CreatedBy string `json:"created_by,omitempty"`
		CreatedAt int64  `json:"created_at,omitempty"`
		ExpireAt  int64  `json:"expire_at,omitempty"`
		MaxUses   int32  `json:"max_uses,omitempty"`
		UsedCount int32  `json:"used_count,omitempty"`
		Revoked   bool   `json:"revoked,omitempty"`
		RevokedAt int64  `json:"revoked_at,omitempty"`
	}
	GroupInviteLinkCreateReq {
		GroupId       string `json:"group_id"`
		ExpireSeconds int64  `json:"expire_seconds,optional"` // 0=永不过期
		MaxUses       int32  `json:"max_uses,optional"` // 0=无限
	}
	GroupInviteLinkCreateResp {
		Link GroupInviteLink `json:"link,omitempty"`
	}
	GroupInviteLinkListReq {
		GroupId        string `form:"group_id"`
		IncludeRevoked bool   `form:"include_revoked,optional"`
	}
	GroupInviteLinkListResp {
		List []GroupInviteLink `json:"list,omitempty"`
	}
	GroupInviteLinkRevokeReq {
		GroupId string `json:"group_id"`
		Token   string `json:"token"`
	}
	GroupInviteLinkRevokeResp  {}
	GroupJoinByTokenReq {
		Token  string `json:"token"`
		ReqMsg string `json:"req_msg,optional"`
	}
	GroupJoinByTokenResp {
		GroupId string `json:"group_id"`
		IsPass  int32  `json:"is_pass"` // 1=直接进群 0=进入申请流程
	}
)

// ---------------- 群成员资料（群内昵称/群备注/@列表） ----------------
type (
	GroupMemberSetting {
		GroupId       string `json:"group_id,omitempty"`
		UserId        string `json:"user_id,omitempty"`
		GroupNickname string `json:"group_nickname,omitempty"`
		GroupRemark   string `json:"group_remark,omitempty"`
		UpdatedAt     int64  `json:"updated_at,omitempty"`
	}
	GetMyGroupMemberSettingReq {
		GroupId string `form:"group_id"`
	}
	GetMyGroupMemberSettingResp {
		Setting GroupMemberSetting `json:"setting,omitempty"`
	}
	UpdateMyGroupMemberSettingReq {
		GroupId       string `json:"group_id"`
		GroupNickname string `json:"group_nickname,optional"`
		GroupRemark   string `json:"group_remark,optional"`
	}
	UpdateMyGroupMemberSettingResp  {}
	AtMember {
		UserId        string `json:"user_id,omitempty"`
		Nickname      string `json:"nickname,omitempty"`
		GroupNickname string `json:"group_nickname,omitempty"`
		Avatar        string `json:"avatar,omitempty"`
		RoleLevel     int32  `json:"role_level,omitempty"`
	}
	GroupAtListReq {
		GroupId string `form:"group_id"`
		Keyword string `form:"keyword,optional"`
	}
	GroupAtListResp {
		List []AtMember `json:"list,omitempty"`
	}
)

// ---------------- 公告历史/置顶 ----------------
type (
	GroupAnnouncement {
		Id        int64  `json:"id,omitempty"`
		GroupId   string `json:"group_id,omitempty"`
		Content   string `json:"content,omitempty"`
		CreatedBy string `json:"created_by,omitempty"`
		CreatedAt int64  `json:"created_at,omitempty"`
		Pinned    bool   `json:"pinned,omitempty"`
		PinnedAt  int64  `json:"pinned_at,omitempty"`
	}
	GroupAnnouncementCreateReq {
		GroupId string `json:"group_id"`
		Content string `json:"content"`
	}
	GroupAnnouncementCreateResp {
		Id int64 `json:"id,omitempty"`
	}
	GroupAnnouncementListReq {
		GroupId        string `form:"group_id"`
		IncludeDeleted bool   `form:"include_deleted,optional"`
	}
	GroupAnnouncementListResp {
		List []GroupAnnouncement `json:"list,omitempty"`
	}
	GroupAnnouncementPinReq {
		GroupId        string `json:"group_id"`
		AnnouncementId int64  `json:"announcement_id"`
		Pinned         bool   `json:"pinned"`
	}
	GroupAnnouncementPinResp  {}
)

type (
	GroupDetailReq {
		GroupId string `form:"group_id"`
	}
	GroupDetailResp {
		Group   Groups          `json:"group"`
		Members []*GroupMembers `json:"members"`
	}
)

type (
	FriendsOnlineReq  {}
	FriendsOnlineResp {
		OnlineList map[string]bool `json:"onLineList"`
	}
)

type (
	GroupUserOnlineReq {
		GroupId string `form:"group_id,optional"`
	}
	GroupUserOnlineResp {
		OnlineList map[string]bool `json:"onLineList"`
	}
)

type (
	GroupSearchReq {
		Keyword string `form:"keyword"` // 群号(精确) 或 群名(模糊)
		Page    int64  `form:"page,optional"` // 页码，从1开始
		Size    int64  `form:"size,optional"` // 每页大小
	}
	GroupSearchItem {
		Id          string `json:"id"`
		Name        string `json:"name"`
		Icon        string `json:"icon"`
		Description string `json:"description"`
		CreatorUid  string `json:"creator_uid"`
		MemberCount int64  `json:"member_count"`
	}
	GroupSearchResp {
		List  []GroupSearchItem `json:"list"`
		Total int64             `json:"total"`
	}
)

@server (
	prefix: v1/social
	group:  friend
	jwt:    JwtAuth
)
service social {
	@doc "好友申请"
	@handler friendPutIn
	post /friend/putIn (FriendPutInReq) returns (FriendPutInResp)

	@doc "更新好友备注"
	@handler friendRemark
	post /friend/remark (FriendRemarkReq) returns (FriendRemarkResp)

	@doc "删除好友（双向）"
	@handler friendDelete
	post /friend/delete (FriendDeleteReq) returns (FriendDeleteResp)

	@doc "拉黑/取消拉黑"
	@handler friendBlock
	post /friend/block (FriendBlockReq) returns (FriendBlockResp)

	@doc "朋友圈权限"
	@handler friendMomentsPermission
	post /friend/momentsPermission (FriendMomentsPermissionReq) returns (FriendMomentsPermissionResp)

	@doc "消息通知开关"
	@handler friendNotification
	post /friend/notification (FriendNotificationReq) returns (FriendNotificationResp)

	@doc "置顶开关"
	@handler friendPin
	post /friend/pin (FriendPinReq) returns (FriendPinResp)

	@doc "静音开关"
	@handler friendMute
	post /friend/mute (FriendMuteReq) returns (FriendMuteResp)

	@doc "好友标签设置"
	@handler friendTags
	post /friend/tags (FriendTagsReq) returns (FriendTagsResp)

	@doc "好友举报"
	@handler friendReport
	post /friend/report (FriendReportReq) returns (FriendReportResp)

	@doc "好友分享（预留）"
	@handler friendShare
	post /friend/share (FriendShareReq) returns (FriendShareResp)

	@doc "好友申请处理"
	@handler friendPutInHandle
	put /friend/putIn (FriendPutInHandleReq) returns (FriendPutInHandleResp)

	@doc "好友申请已读"
	@handler friendPutInRead
	put /friend/putIn/read (FriendPutInReadReq) returns (FriendPutInReadResp)

	@doc "好友申请列表"
	@handler friendPutInList
	get /friend/putIns (FriendPutInListReq) returns (FriendPutInListResp)

	@doc "删除好友申请"
	@handler friendPutInDelete
	post /friend/putIn/delete (FriendPutInDeleteReq) returns (FriendPutInDeleteResp)

	@doc "获取好友申请消息数量"
	@handler friendPutInMessageCount
	get /friend/putIn/messageCount (FriendPutInMessageCountReq) returns (FriendPutInMessageCountResp)

	@doc "好友列表"
	@handler friendList
	get /friends (FriendListReq) returns (FriendListResp)

	@doc "好友在线情况"
	@handler friendsOnline
	get /friends/online (FriendsOnlineReq) returns (FriendsOnlineResp)
}

@server (
	prefix: v1/social
	group:  group
	jwt:    JwtAuth
)
service social {
	@doc "创群"
	@handler createGroup
	post /group (GroupCreateReq) returns (GroupCreateResp)

	@doc "申请进群"
	@handler groupPutIn
	post /group/putIn (GroupPutInReq) returns (GroupPutInResp)

	@doc "申请进群处理"
	@handler groupPutInHandle
	put /group/putIn (GroupPutInHandleReq) returns (GroupPutInHandleResp)

	@doc "申请进群列表"
	@handler groupPutInList
	get /group/putIns (GroupPutInListReq) returns (GroupPutInListResp)

	@doc "用户角度的群申请列表"
	@handler getGroupPutListByUid
	get /group/putInsByUid (GetGroupPutListByUidReq) returns (GetGroupPutListByUidResp)

	@doc "群申请与邀请未读数量"
	@handler groupRequestMessageCount
	get /group/putIn/messageCount (GroupRequestMessageCountReq) returns (GroupRequestMessageCountResp)

	@doc "把我管理的群收到的入群申请全部标记已读"
	@handler groupPutInsRead
	put /group/putIns/read (GroupPutInsReadReq) returns (GroupPutInsReadResp)

	@doc "用户申群列表"
	@handler groupList
	get /groups (GroupListReq) returns (GroupListResp)

	@doc "搜索群（群号精确+群名模糊，分页）"
	@handler groupSearch
	get /group/search (GroupSearchReq) returns (GroupSearchResp)

	@doc "成员列表列表"
	@handler groupUserList
	get /group/users (GroupUserListReq) returns (GroupUserListResp)

	@doc "群在线用户"
	@handler groupUserOnline
	get /group/users/online (GroupUserOnlineReq) returns (GroupUserOnlineResp)

	@doc "退出群组"
	@handler groupQuit
	post /group/quit (GroupQuitReq) returns (GroupQuitResp)

	@doc "踢出群成员"
	@handler groupKick
	post /group/kick (GroupKickReq) returns (GroupKickResp)

	@doc "邀请群成员"
	@handler groupInvite
	post /group/invite (GroupInviteReq) returns (GroupInviteResp)

	@doc "创建群邀请"
	@handler groupInvitationCreate
	post /group/invitations (GroupInvitationCreateReq) returns (GroupInvitationCreateResp)

	@doc "收到的群邀请"
	@handler groupInvitationList
	get /group/invitations (GroupInvitationListReq) returns (GroupInvitationListResp)

	@doc "标记收到的群邀请已读"
	@handler groupInvitationRead
	put /group/invitations/read (GroupInvitationReadReq) returns (GroupInvitationReadResp)

	@doc "处理群邀请"
	@handler groupInvitationHandle
	put /group/invitations/:id (GroupInvitationHandleReq) returns (GroupInvitationHandleResp)

	@doc "更新群信息"
	@handler groupUpdate
	post /group/update (GroupUpdateReq) returns (GroupUpdateResp)

	@doc "群详情"
	@handler groupDetail
	get /group/detail (GroupDetailReq) returns (GroupDetailResp)

	@doc "解散群（仅群主）"
	@handler groupDisband
	post /group/disband (GroupDisbandReq) returns (GroupDisbandResp)

	@doc "转让群主（仅群主）"
	@handler groupTransferOwner
	post /group/transferOwner (GroupTransferOwnerReq) returns (GroupTransferOwnerResp)

	@doc "设置/取消管理员（仅群主）"
	@handler groupSetAdmin
	post /group/setAdmin (GroupSetAdminReq) returns (GroupSetAdminResp)

	@doc "创建邀请链接/二维码（管理员/群主）"
	@handler groupInviteLinkCreate
	post /group/inviteLink/create (GroupInviteLinkCreateReq) returns (GroupInviteLinkCreateResp)

	@doc "邀请链接列表（管理员/群主）"
	@handler groupInviteLinkList
	get /group/inviteLinks (GroupInviteLinkListReq) returns (GroupInviteLinkListResp)

	@doc "撤销邀请链接（管理员/群主/创建者）"
	@handler groupInviteLinkRevoke
	post /group/inviteLink/revoke (GroupInviteLinkRevokeReq) returns (GroupInviteLinkRevokeResp)

	@doc "通过邀请token入群（链接/二维码）"
	@handler groupJoinByToken
	post /group/joinByToken (GroupJoinByTokenReq) returns (GroupJoinByTokenResp)

	@doc "获取我的群成员资料（群内昵称/群备注）"
	@handler getMyGroupMemberSetting
	get /group/memberSetting (GetMyGroupMemberSettingReq) returns (GetMyGroupMemberSettingResp)

	@doc "更新我的群成员资料（群内昵称/群备注）"
	@handler updateMyGroupMemberSetting
	post /group/memberSetting (UpdateMyGroupMemberSettingReq) returns (UpdateMyGroupMemberSettingResp)

	@doc "群 @ 列表"
	@handler groupAtList
	get /group/atList (GroupAtListReq) returns (GroupAtListResp)

	@doc "发布群公告（管理员/群主）"
	@handler groupAnnouncementCreate
	post /group/announcement (GroupAnnouncementCreateReq) returns (GroupAnnouncementCreateResp)

	@doc "群公告列表"
	@handler groupAnnouncementList
	get /group/announcements (GroupAnnouncementListReq) returns (GroupAnnouncementListResp)

	@doc "置顶/取消置顶群公告（管理员/群主）"
	@handler groupAnnouncementPin
	post /group/announcement/pin (GroupAnnouncementPinReq) returns (GroupAnnouncementPinResp)
}

