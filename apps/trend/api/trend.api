syntax = "v1"

info (
	title:   "动态服务API"
	author:  "iceymoss"
	version: "v1.0.0"
	desc:    "正式环境动态、评论、点赞服务接口"
)

// ===== 动态核心服务 =====
@server (
	prefix: /v1
	group:  trend
	jwt:    JwtAuth
)
service trend {
	@doc "创建新动态"
	@handler createTrend
	post /trend (CreateTrendRequest) returns (CreateTrendResponse)

	@doc "删除动态"
	@handler deleteTrend
	post /trend/delete (DeleteTrendRequest) returns (DeleteTrendResponse)

	@doc "更新动态内容"
	@handler updateTrend
	put /trend/update (UpdateTrendRequest) returns (UpdateTrendResponse)

	@doc "获取动态列表"
	@handler listTrends
	get /trends (ListTrendsRequest) returns (ListTrendsResponse)

	@doc "获取动态详情"
	@handler getTrendDetail
	get /trend/detail (GetTrendDetailRequest) returns (GetTrendDetailResponse)

	@doc "获取最新动态流"
	@handler getLatestTrends
	get /trends/latest (GetLatestTrendsRequest) returns (GetLatestTrendsResponse)

	@doc "获取用户个人动态"
	@handler getUserTrends
	get /user/trends (GetUserTrendsRequest) returns (GetUserTrendsResponse)
}

// ===== 评论服务 =====
@server (
	prefix: /v1
	group:  comment
	jwt:    JwtAuth
)
service trend {
	@doc "创建新评论"
	@handler createDiscuss
	post /comment (CreateDiscussReq) returns (CreateDiscussResp)

	@doc "获取评论树"
	@handler getDiscussesTree
	get /comment/tree (GetDiscussesReq) returns (DiscussesTreeResp)

	@doc "获取一级评论"
	@handler getRootDiscusses
	get /comment/root (GetDiscussesReq) returns (DiscussesListResp)

	@doc "获取子评论列表"
	@handler getChildDiscusses
	get /comment/children (GetChildDiscussesReq) returns (DiscussesListResp)

	@doc "删除评论"
	@handler deleteDiscuss
	delete /comment (DeleteDiscussReq) returns (DeleteDiscussResp)

	@doc "获取未读回复通知"
	@handler getUnreadReplies
	get /comment/unread (GetUnreadRepliesReq) returns (RepliesListResp)

	@doc "标记评论为已读"
	@handler markDiscussRead
	put /comment/mark-read (MarkDiscussRequest) returns (MarkDiscussResponse)
}

// ===== 点赞服务 =====
@server (
	prefix: /v1
	group:  like
	jwt:    JwtAuth
)
service trend {
	@doc "点赞/取消点赞"
	@handler toggleLike
	post /like (LikeToggleRequest) returns (LikeToggleResponse)

	@doc "获取动态点赞摘要"
	@handler getTrendLikeSummary
	get /like/summary (GetTrendLikeSummaryRequest) returns (GetTrendLikeSummaryResponse)

	@doc "批量获取点赞摘要"
	@handler batchGetTrendLikeSummary
	get /like/batch-summary (BatchTrendLikeSummaryRequest) returns (BatchTrendLikeSummaryResponse)

	@doc "获取点赞用户列表"
	@handler getLikedUsers
	get /like/users (GetLikedUsersRequest) returns (GetLikedUsersResponse)

	@doc "获取未读点赞通知"
	@handler getUnreadLikes
	get /like/unread (GetUnreadLikesRequest) returns (GetUnreadLikesResponse)

	@doc "标记点赞为已读"
	@handler markLikesRead
	put /like/mark-read (MarkLikesReadRequest) returns (MarkLikesReadResponse)
}

// ===== 数据结构定义 =====
// 创建动态请求
type CreateTrendRequest {
	TrendType    int      `json:"type"`
	Content      string   `json:"content,optional"`
	Scope        int      `json:"scope"`
	Resources    []string `json:"resources,optional"`
	PositionName string   `json:"position_name,optional"`
	Longitude    float64  `json:"longitude,optional"`
	Latitude     float64  `json:"latitude,optional"`
	Title        string   `json:"title,optional"`
	AtUserIDs    []int32  `json:"at_user_ids,optional"`
	OpenReply    bool     `json:"open_reply,optional"`
	CoverUrl     string   `json:"cover_url,optional"`
	ShareUrl     string   `json:"share_url,optional"`
	Device       string   `json:"device,optional"`
	IP           string   `json:"ip,optional"`
}

// 创建动态响应
type CreateTrendResponse {
	TrendID int `json:"trend_id"`
	Code    int `json:"code"`
}

// 删除动态请求
type DeleteTrendRequest {
	TrendID int `json:"trend_id"`
}

// 删除动态响应
type DeleteTrendResponse {
	Success bool `json:"success"`
}

// 更新动态请求
type UpdateTrendRequest {
	TrendId   uint32 `json:"trend_id"` // 动态id
	IsTop     int32  `json:"is_top,optional"` // 设置置顶: 0否，1是
	OpenReply int32  `json:"open_reply,optional"` // 是否开启评论区: 0否，1是
	Scope     int32  `json:"scope,optional"` // 可见范围:2不可见，1可见
}

// 更新动态响应
type UpdateTrendResponse {}

// 动态列表请求
type ListTrendsRequest {
	LastID     int      `json:"last_id"`
	LastTime   int      `json:"last_time"`
	Types      []string `json:"types"`
	SortColumn string   `json:"sort_column"`
	SortType   int      `json:"sort_type"`
	UserIDs    []string `json:"user_ids"`
}

// 动态列表响应
type ListTrendsResponse {
	Trends   []string `json:"trends"`
	LastID   int      `json:"last_id"`
	LastTime int      `json:"last_time"`
}

// 动态详情请求
type GetTrendDetailRequest {
	TrendID int `json:"trend_id"`
}

// 动态详情响应
type GetTrendDetailResponse {
	Trend *Trend `json:"trend"`
}

// 最新动态请求
type GetLatestTrendsRequest {
	LastTrendID int `json:"last_trend_id,optional"`
	Count       int `json:"count,optional"`
}

// ===== 动态核心数据结构 =====
type Trend {
	Id            int64     `json:"id,omitempty"` // 动态唯一ID
	User          *User     `json:"user_id,omitempty"` // 发布用户ID
	Type          int       `json:"type,omitempty"` // 动态类型
	Content       string    `json:"content,omitempty"` // 文本内容
	Scope         int       `json:"scope,omitempty"` // 可见范围
	CreateTime    int64     `json:"create_time,omitempty"` // 原始创建时间
	ReplyCount    int32     `json:"reply_count,omitempty"` // 评论数量
	AgreeCount    int32     `json:"agree_count,omitempty"` // 点赞数量
	PositionName  string    `json:"position_name,omitempty"` // 位置信息
	PositionPoint []float32 `json:"position_point,omitempty"` // 经纬度
	Title         string    `json:"title,omitempty"` // 长文标题
	AtUserIds     []*User   `json:"at_user,omitempty"` // @的用户ID列表
	Resources     []string  `json:"resources,omitempty"` // 图片/视频资源
	CoverUrl      string    `json:"cover_url,omitempty"` // 封面图URL
	ShareUrl      string    `json:"share_url,omitempty"` // 第三方分享链接
	OpenReply     int32     `json:"open_reply,omitempty"` // 是否允许评论
	DeviceId      string    `json:"device_id,omitempty"` // 发布设备ID
	Ip            string    `json:"ip,omitempty"` // IP信息
	isTop         int       `json:"is_top,omitempty"` // 是否置顶
}

type User {
	Id       string `json:"id"`
	Nickname string `json:"nickname"`
	Sex      int    `json:"sex"`
	Avatar   string `json:"avatar"`
}

// 最新动态响应
type GetLatestTrendsResponse {
	Trends      []*Trend `json:"list"` // 动态列表
	LastTrendID int      `json:"last_trend_id"` // 最后一条动态ID
	HasMore     bool     `json:"has_more"` // 是否还有更多数据
}

// 用户动态请求
type GetUserTrendsRequest {
	TargetUserID int `json:"target_user_id"`
	LastID       int `json:"last_id,optional"`
}

// 用户动态响应
type GetUserTrendsResponse {
	Trends    []*Trend `json:"list"`
	TopTrends []*Trend `json:"top_list"`
	LastID    int      `json:"last_id"`
	LastTime  int      `json:"last_time"`
}

// 创建评论请求
type CreateDiscussReq {
	TrendID   string   `json:"trend_id"`
	Father    string   `json:"father"`
	UserID    string   `json:"user_id"`
	Content   string   `json:"content"`
	AtUserIDs []string `json:"at_user_ids"`
	Replyer   string   `json:"replyer"`
}

// 创建评论响应
type CreateDiscussResp {
	DiscussJSON string `json:"discuss_json"`
}

// 获取评论请求
type GetDiscussesReq {
	TrendID         string   `json:"trend_id"`
	LastID          int      `json:"last_id"`
	LastTime        int      `json:"last_time"`
	IncludeChildren bool     `json:"include_children"`
	UIDs            []string `json:"uids"`
}

// 评论树响应
type DiscussesTreeResp {
	DiscussesJSON string `json:"discusses_json"`
	LastID        int    `json:"last_id"`
	LastTime      int    `json:"last_time"`
}

// 评论列表响应
type DiscussesListResp {
	DiscussesJSON string `json:"discusses_json"`
	LastID        int    `json:"last_id"`
	LastTime      int    `json:"last_time"`
	Total         int    `json:"total"`
}

// 子评论请求
type GetChildDiscussesReq {
	RootID   string `json:"root_id"`
	Father   string `json:"father"`
	LastID   int    `json:"last_id"`
	LastTime int    `json:"last_time"`
}

// 删除评论请求
type DeleteDiscussReq {
	ID string `json:"id"`
}

// 删除评论响应
type DeleteDiscussResp {
	Success bool `json:"success"`
}

// 未读回复请求
type GetUnreadRepliesReq {
	UserID   string `json:"user_id"`
	LastID   int    `json:"last_id"`
	LastTime int    `json:"last_time"`
}

// 未读回复响应
type RepliesListResp {
	RepliesJSON string `json:"replies_json"`
	LastID      int    `json:"last_id"`
	LastTime    int    `json:"last_time"`
	Total       int    `json:"total"`
}

// 标记评论已读请求
type MarkDiscussRequest {
	UserID string   `json:"user_id"`
	DisIDs []string `json:"dis_ids"`
}

// 标记评论已读响应
type MarkDiscussResponse {}

// 点赞操作请求
type LikeToggleRequest {
	UserID   string `json:"user_id"`
	TrendID  string `json:"trend_id"`
	AuthorID string `json:"author_id"`
	LikeType int    `json:"like_type"`
}

// 点赞操作响应
type LikeToggleResponse {
	Success      bool   `json:"success"`
	ErrorMessage string `json:"error_message"`
}

// 点赞摘要请求
type GetTrendLikeSummaryRequest {
	UserID  string `json:"user_id"`
	TrendID string `json:"trend_id"`
}

// 点赞摘要响应
type GetTrendLikeSummaryResponse {
	SummaryJSON string `json:"summary_json"`
}

// 批量摘要请求
type BatchTrendLikeSummaryRequest {
	UserID   string   `json:"user_id"`
	TrendIDs []string `json:"trend_ids"`
}

// 批量摘要响应
type BatchTrendLikeSummaryResponse {
	SummariesJSON string `json:"summaries_json"`
}

// 点赞用户列表请求
type GetLikedUsersRequest {
	TrendID string `json:"trend_id"`
	Cursor  int    `json:"cursor"`
	Limit   int    `json:"limit"`
}

// 点赞用户列表响应
type GetLikedUsersResponse {
	UsersJSON  string `json:"users_json"`
	NextCursor int    `json:"next_cursor"`
	HasMore    bool   `json:"has_more"`
	Total      int    `json:"total"`
}

// 未读点赞请求
type GetUnreadLikesRequest {
	UserID string `json:"user_id"`
	LastID int    `json:"last_id"`
}

// 未读点赞响应
type GetUnreadLikesResponse {
	LikesJSON   string `json:"likes_json"`
	TotalUnread int    `json:"total_unread"`
	LastID      int    `json:"last_id"`
}

// 标记点赞已读请求
type MarkLikesReadRequest {
	UserID  string   `json:"user_id"`
	LikeIDs []string `json:"like_ids"`
}

// 标记点赞已读响应
type MarkLikesReadResponse {}

