syntax = "v1"

info (
	title:  "用户服务的实例对象"
	author: "iceymoss"
)

import (
	"domain.api"
)

// -------------- user api v1 --------------
// no need login
@server (
	prefix: /api/v1/user
	group:  user
)
service user {
	@doc "用户注册"
	@handler register
	post /register (RegisterReq) returns (RegisterResp)

	@doc "用户登入"
	@handler login
	post /login (LoginReq) returns (LoginResp)

	@doc "发送邮件验证码"
	@handler sendEmailCode
	post /email/code (SendVerificationEmailReq) returns (SendVerificationEmailResp)

	@doc "验证邮箱"
	@handler verifyEmail
	post /email/verify (VerifyEmailReq) returns (VerifyEmailResp)

	@doc "发送手机验证码"
	@handler sendPhoneCode
	post /phone/code (SendPhoneCodeReq) returns (SendPhoneCodeResp)

	@doc "验证手机验证码"
	@handler verifyPhoneCode
	post /phone/verify (VerifyPhoneCodeReq) returns (VerifyPhoneCodeResp)

	@doc "重置密码"
	@handler resetPwd
	put /reset_pwd (ResetPassWordReq) returns (ResetPassWordResp)
}

//need login
@server (
	prefix: api/v1/user
	group:  user
	jwt:    JwtAuth
)
service user {
	@doc "获取用户信息"
	@handler detail
	get /detail (UserInfoReq) returns (UserInfoResp)

	@doc "修改用户信息"
	@handler update
	put /update (UpdateUserReq) returns (UpdateUserResp)

	@doc "上传头像"
	@handler uploadAvatar
	post /avatar/upload (UploadAvatarReq) returns (UploadAvatarResp)

	@doc "绑定/更新邮箱"
	@handler bindEmail
	post /email/bind (BindEmailReq) returns (BindEmailResp)

	@doc "注销账号"
	@handler logout
	delete /logout (LogoutReq) returns (LogoutResp)
}

